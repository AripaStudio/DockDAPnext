  <Target Name="MergeDependencies"
      AfterTargets="CopyFilesToOutputDirectory"
      BeforeTargets="ValidateVsixParts"
      Inputs="@(IntermediateAssembly)"
      Outputs="$(IntermediateOutputPath)ilrepack.stamp"
      Condition="'$(OS)' == 'Windows_NT' And '$(DisableMerge)' != 'true'">

    <PropertyGroup>
      <NewtonsoftVer>13.0.1</NewtonsoftVer>
      <ILRepackExe>$(NuGetPackageRoot)ilrepack\2.0.48\tools\ILRepack.exe</ILRepackExe>
      <!-- Visual Studio sets DevEnvDir to the literal '*Undefined*' for command-line builds; that path is illegal in ILRepack. -->
      <VsLibDir Condition="'$(DevEnvDir)' != '' And '$(DevEnvDir)' != '*Undefined*'">$(DevEnvDir)PublicAssemblies</VsLibDir>
      <VsLibArg Condition="'$(VsLibDir)' != '' And '$(VsLibDir)' != '*Undefined*'">/lib:&quot;$(VsLibDir)&quot;</VsLibArg>
      <NewtonsoftDir>$(NuGetPackageRoot)newtonsoft.json\$(NewtonsoftVer)\lib\net45</NewtonsoftDir>
      <OutDirFull>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(OutDir)'))</OutDirFull>
      <OutDirFull>$(OutDirFull.TrimEnd('\'))</OutDirFull>
      <ObjDll>@(IntermediateAssembly->'%(FullPath)')</ObjDll>
      <MergedDll>$(OutDirFull)\DockDAPnext.dll</MergedDll>
    </PropertyGroup>

    <ItemGroup>
      <MergeInput Include="@(ReferenceCopyLocalPaths)"
            Condition="'%(Filename)' == 'ReactiveUI' Or '%(Filename)' == 'System.Reactive' Or '%(Filename)' == 'DynamicData' Or '%(Filename)' == 'Splat' Or '%(Filename)' == 'Splat.Core' Or '%(Filename)' == 'Splat.Builder' Or '%(Filename)' == 'Splat.Logging'" />
      <MergeInput Include="$(NewtonsoftDir)\Newtonsoft.Json.dll" />
    </ItemGroup>

    <Exec Command="&quot;$(ILRepackExe)&quot; $(VsLibArg) /lib:&quot;$(OutDirFull)&quot; /lib:&quot;$(NewtonsoftDir)&quot; /log:&quot;$(OutDirFull)\ilrepack.log&quot; /out:&quot;$(MergedDll)&quot; &quot;$(ObjDll)&quot; @(MergeInput->'&quot;%(FullPath)&quot;', ' ')" />

    <Copy SourceFiles="$(MergedDll)" DestinationFiles="$(ObjDll)" />
    <Copy SourceFiles="$(OutDirFull)\DockDAPnext.pdb" DestinationFiles="$(IntermediateOutputPath)DockDAPnext.pdb" Condition="Exists('$(OutDirFull)\DockDAPnext.pdb')" />
    <!-- ILRepack writes bin\DockDAPnext.dll directly, so its PDB carries the real name and the debugger resolves it. -->
    <Touch Files="$(IntermediateOutputPath)ilrepack.stamp" AlwaysCreate="true" />
  </Target>

  <!-- Defensive: Rebuild already drops the stamp via Clean; this also covers no-merge builds that skip Clean. -->
  <Target Name="InvalidateMergeStamp"
      AfterTargets="Build"
      Condition="'$(OS)' == 'Windows_NT' And '$(DisableMerge)' == 'true'">
    <Delete Files="$(IntermediateOutputPath)ilrepack.stamp" />
  </Target>

  <Target Name="ExcludeMergedFromVsix"
      AfterTargets="CopyFilesToOutputDirectory"
      BeforeTargets="ValidateVsixParts"
      Condition="'$(OS)' == 'Windows_NT' And '$(DisableMerge)' != 'true'">
    <ItemGroup>
      <MergedAway Include="@(ReferenceCopyLocalPaths)"
            Condition="'%(Filename)' == 'ReactiveUI' Or '%(Filename)' == 'System.Reactive' Or '%(Filename)' == 'DynamicData' Or '%(Filename)' == 'Splat' Or '%(Filename)' == 'Splat.Core' Or '%(Filename)' == 'Splat.Builder' Or '%(Filename)' == 'Splat.Logging' Or '%(Filename)' == 'Newtonsoft.Json'" />
      <ReferenceCopyLocalPaths Remove="@(MergedAway)" />
    </ItemGroup>
  </Target>

