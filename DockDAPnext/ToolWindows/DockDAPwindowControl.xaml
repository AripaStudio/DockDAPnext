<UserControl x:Class="DockDAPnext.DockDaPwindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:theming="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:util="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Utilities"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:uc="clr-namespace:DockDAPnext.UserControls"
             toolkit:Themes.UseVsTheme="True"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="400"
             Name="MainWindowDockDAP">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DockDAPnext;component/Themes/UIStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="15"
                   Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"
                   HorizontalAlignment="Center" FontSize="14" FontWeight="Bold">
            Welcome to DockDAP by Aripa Pars Studio
        </TextBlock>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,0">
                <Border Margin="0,0,0,10" Padding="10" CornerRadius="3"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}"
                        Background="{DynamicResource {x:Static vs:VsBrushes.CommandBarMenuBackgroundGradientKey}}">
                    <StackPanel>
                        <TextBlock Text="Solution project"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"/>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right"
                                    Content="Refresh"
                                    Margin="6,0,0,0"
                                    Command="{Binding ButtonCommandRefreshProjects}"
                                    ToolTip="Re-read the solution projects and their dub.json files"/>
                            <ComboBox ItemsSource="{Binding SolutionProjects}"
                                      SelectedItem="{Binding SelectedSolutionProject}"
                                      DisplayMemberPath="DisplayName"
                                      AutomationProperties.AutomationId="SolutionProjectSelector"
                                      AutomationProperties.Name="Solution project"
                                      MinHeight="24"
                                      VerticalContentAlignment="Center"
                                      ToolTip="Each project's dub.json is managed separately"/>
                        </DockPanel>
                        <TextBlock Text="{Binding SelectedProjectStatus}"
                                   AutomationProperties.AutomationId="SelectedProjectStatus"
                                   AutomationProperties.LiveSetting="Polite"
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <DockPanel Margin="0,0,0,10">
                    <Label BorderBrush="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}" BorderThickness="1"
                           Padding="8,5"
                           Content="Create dub.json File : "
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"
                           VerticalAlignment="Center"/>
                    <Button Content="Create or load File" Margin="5,0,0,0"
                            Command="{Binding ButtonCommandCreateOrLoadFile}"/>
                </DockPanel>

                <TabControl>
                    <TabItem Header="Project">
                        <uc:UCprojectDubManager/>
                    </TabItem>
                    <TabItem Header="Show Dub.json">
                        <uc:UCshowDubFile/>
                    </TabItem>
                    <TabItem Header="Build With Dub">
                        <uc:UCbuildDubFile/>
                    </TabItem>
                    <TabItem Header="AI Assistant">
                        <uc:UCaiAssistant/>
                    </TabItem>
                    <TabItem Header="Help">
                        <uc:UChelp/>
                    </TabItem>
                    <TabItem Header="About Me">
                        <uc:UCabouteMe/>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource {x:Static vs:VsBrushes.CommandBarMenuBackgroundGradientKey}}"
                BorderBrush="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}"
                BorderThickness="0,1,0,0">
            <Button Margin="15" Style="{StaticResource HeroButton}"
                    Content="Save File"
                    Command="{Binding ButtonCommandSaveFile}"/>
        </Border>
    </Grid>
</UserControl>
