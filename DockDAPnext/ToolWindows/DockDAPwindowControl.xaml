<UserControl x:Class="DockDAPnext.DockDAPwindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:theming="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:util="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Utilities"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
             xmlns:uc="clr-namespace:DockDAPnext.UserControls"
             toolkit:Themes.UseVsTheme="True"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="400"
             Name="MainWindowDockDAP">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="15" Foreground="White" 
                   HorizontalAlignment="Center" FontSize="14" FontWeight="Bold">
            Welcome to DockDAP by Aripa Pars Studio
        </TextBlock>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,0">
                <DockPanel Margin="0,0,0,10">
                    <Label BorderBrush="#3F3F46" BorderThickness="1" 
                           Content="Create dub.json File : " Foreground="White" VerticalAlignment="Center"/>
                    <Button BorderBrush="#3F3F46" Background="#333337" Content="Create or load File"
                            Foreground="White" Padding="10,2" Margin="5,0,0,0"/>
                </DockPanel>

                <TabControl BorderBrush="#3F3F46" BorderThickness="1" 
                            Background="#2D2D30" Foreground="#F1F1F1" Padding="5">
                    <TabItem Header="Project">
                        <uc:UCprojectDubManager/>
                    </TabItem>
                    <TabItem Header="Show Dub.json">
                        <uc:UCshowDubFile/>
                    </TabItem>
                    <TabItem Header="Build With Dub">
                        <uc:UCbuildDubFile/>
                    </TabItem>
                    <TabItem Header="About Me">
                        <uc:UCabouteMe/>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,1,0,0">
            <Button Margin="15" Padding="20,8" Background="#007ACC" 
                    Content="Save File" Foreground="White" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand"
                    
                    />
        </Border>
    </Grid>
</UserControl>
