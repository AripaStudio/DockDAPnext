	<Commands package="guidDockDAPnextPackage">
		<Groups>
			<Group guid="guidDockDAPnextPackageCmdSet" id="ToolsMenuGrouping" priority="0x0101">
				<Parent guid="VSMainMenu" id="Tools"/>
			</Group>
		</Groups>

		<Buttons>
			<Button guid="guidDockDAPnextPackageCmdSet" id="ShowDockDAPwindowCommand" priority="0x0100" type="Button">
				<Parent guid="guidDockDAPnextPackageCmdSet" id="ToolsMenuGrouping" />
				<Icon guid="ImageCatalogGuid" id="StatusInformation" />
				<CommandFlag>IconIsMoniker</CommandFlag>
				<Strings>
					<ButtonText>Open DockDAP</ButtonText>
				</Strings>
			</Button>
		</Buttons>
	</Commands>

	<Symbols>
