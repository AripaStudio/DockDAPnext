		<GuidSymbol name="guidDockDAPnextPackageCmdSet" value="{CF2F943D-81C9-4C79-830A-30224C0AF594}">
			<IDSymbol name="ToolsMenuGrouping" value="0x0101" />
			<IDSymbol name="ShowDockDAPwindowCommand" value="0x0100"/>
		</GuidSymbol>
	</Symbols>

</CommandTable>