<UserControl x:Class="DockDAPnext.UserControls.projectManagersUCs.UCdependenciesSectionManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DockDAPnext.UserControls.projectManagersUCs"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">
    <Grid Background="#1E1E1E" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Project Dependencies"
                   Foreground="#007ACC"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15" />

        <Border Grid.Row="1"
                Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15">

            <StackPanel>

                <TextBlock Text="Add New Dependency (Key: Package Name, Value: Version)" 
                           Foreground="#DCDCDC" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,10"
                           FontSize="13"/>

                <Grid Margin="0,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Key:" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,5"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             ToolTip="Enter the package name (e.g., vibe-d)"
                             Background="#3F3F46"
                             Foreground="#F1F1F1"
                             CaretBrush="#F1F1F1"
                             BorderBrush="#555555"
                             Padding="5"
                             Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Value:" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,5,5,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             ToolTip="Enter the required version or path (e.g., ~>1.0.0)"
                             Background="#3F3F46"
                             Foreground="#F1F1F1"
                             CaretBrush="#F1F1F1"
                             BorderBrush="#555555"
                             Padding="5"
                             Margin="0,5,0,0"/>
                </Grid>

                <Button Margin="0,10,0,15"
                        Width="180"
                        Background="#007ACC"
                        Foreground="White"
                        FontWeight="Bold"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Add}" Width="16" Height="16" Margin="0,0,5,0"/>
                        <TextBlock Text="Add Dependency" />
                    </StackPanel>
                </Button>

                <Separator Background="#3F3F46" Margin="0,0,0,15"/>

                <TextBlock Text="Current Dependencies" 
                           Foreground="#DCDCDC" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,5"
                           FontSize="13"/>

                <ListBox 
                    Height="150"
                    Background="#2D2D30"
                    Foreground="#F1F1F1"
                    BorderBrush="#555555"
                    SelectionMode="Single"
                    Margin="0,0,0,10">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" FontWeight="Bold" Foreground="#DCDCDC" Margin="0,0,5,0"/>
                                <TextBlock Grid.Column="1" Text=": " Foreground="#CCCCCC" Margin="0,0,5,0"/>
                                <TextBlock Grid.Column="2" Foreground="#DCDCDC" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button 
                    Width="220"
                    Background="#D0313C" 
                    Foreground="White"
                    FontWeight="Bold"
                    HorizontalAlignment="Center">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Remove}" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock Text="Remove Selected Dependency" />
                        </StackPanel>
                    </Button.Content>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
