<UserControl x:Class="DockDAPnext.UserControls.projectManagersUCs.UCdependenciesSectionManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DockDAPnext.UserControls.projectManagersUCs"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DockDAPnext;component/Themes/UIStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Project Dependencies"
                   Foreground="{DynamicResource {x:Static vs:VsBrushes.AccentMediumKey}}"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15" />

        <Border Grid.Row="1"
                Background="{DynamicResource {x:Static vs:VsBrushes.CommandBarMenuBackgroundGradientKey}}"
                BorderBrush="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15">

            <StackPanel>

                <TextBlock Text="Add New Dependency (Key: Package Name, Value: Version)" 
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,10"
                           FontSize="13"/>

                <Grid Margin="0,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Key:" Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" VerticalAlignment="Center" Margin="0,0,5,5"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             ToolTip="Enter the package name (e.g., vibe-d)"
                            
                            
                            
                            
                             Padding="5"
                             Margin="0,0,0,5"
                             Text="{Binding VmProjectDubManager.TxtAddDependencyKey}"
                             />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Value:" Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" VerticalAlignment="Center" Margin="0,5,5,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             ToolTip="Enter the required version or path (e.g., ~>1.0.0)"
                            
                            
                            
                            
                             Padding="5"
                             Margin="0,5,0,0"
                             Text="{Binding VmProjectDubManager.TxtAddDependencyValue}"
                             />
                </Grid>

                <Button Style="{StaticResource PrimaryButton}" Margin="0,10,0,15"
                        Width="180"
                        HorizontalAlignment="Center"
                        Command="{Binding VmProjectDubManager.ButtonCommandAddDependency}"
                        >
                    <StackPanel Orientation="Horizontal">
                        <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Add}" Width="16" Height="16" Margin="0,0,5,0"/>
                        <TextBlock Text="Add Dependency" />
                    </StackPanel>
                </Button>

                <Separator Margin="0,0,0,15"/>

                <TextBlock Text="Current Dependencies" 
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,5"
                           FontSize="13"/>

                <ListBox 
                    Height="150"
                   
                   
                   
                    SelectionMode="Single"
                    Margin="0,0,0,10"
                    ItemsSource="{Binding VmProjectDubManager.DependenciesListCollection}"
                    SelectedItem="{Binding VmProjectDubManager.SelectedDependencyRemove}"
                    >

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" FontWeight="Bold" Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" Margin="0,0,5,0"/>
                                <TextBlock Grid.Column="1" Text=": " Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" Margin="0,0,5,0"/>
                                <TextBlock Grid.Column="2" Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Style="{StaticResource DangerButton}" 
                    Width="220"
                    HorizontalAlignment="Center"
                    Command="{Binding VmProjectDubManager.ButtonCommandRemoveSelectedDependency}"
                    >
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Remove}" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock Text="Remove Selected Dependency" />
                        </StackPanel>
                    </Button.Content>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
