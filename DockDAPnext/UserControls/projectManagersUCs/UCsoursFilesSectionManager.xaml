<UserControl x:Class="DockDAPnext.UserControls.projectManagersUCs.UCsoursFilesSectionManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DockDAPnext.UserControls.projectManagersUCs"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#1E1E1E" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Source File Management"
                   Foreground="#007ACC"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15" />

        <Border Grid.Row="1"
                Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15">

            <StackPanel>

                <TextBlock Text="Add Source Path" 
                           Foreground="#DCDCDC" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,10"
                           FontSize="13"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Background="#3F3F46"
                             Foreground="#F1F1F1"
                             CaretBrush="#F1F1F1"
                             BorderBrush="#555555"
                             Padding="5"
                             Margin="0,0,10,0"
                             ToolTip="Enter the relative path for the source file or directory."
                             Text="{Binding vmProjectDubManager.txtAddSourcePath, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="1"
                            Width="120"
                            Background="#007ACC"
                            Foreground="White"
                            FontWeight="Bold"
                            Command="{Binding vmProjectDubManager.ButtonCommand_SourceFileAddPath}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Add}" Width="16" Height="16" Margin="0,0,5,0"/>
                                <TextBlock Text="Add Path" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>

                <Separator Background="#3F3F46" Margin="0,15"/>

                <TextBlock Text="Current Source Paths" 
                           Foreground="#DCDCDC" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,5"
                           FontSize="13"/>

                <ListBox 
                    Height="150"
                    Background="#2D2D30"
                    Foreground="#F1F1F1"
                    BorderBrush="#555555"
                    SelectionMode="Single"
                    Margin="0,0,0,10"
                    ItemsSource="{Binding vmProjectDubManager.sourceFilePathListCollection}" 
                    SelectedItem="{Binding vmProjectDubManager.selectedSourcePathListRemove}" />

                <Button 
                    Width="220"
                    Background="#D0313C" 
                    Foreground="White"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    ToolTip="Removes the currently selected path from the source list."
                    Command="{Binding vmProjectDubManager.ButtonCommand_SourceFileRemovePath}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Remove}" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock Text="Remove Selected Path" />
                        </StackPanel>
                    </Button.Content>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
