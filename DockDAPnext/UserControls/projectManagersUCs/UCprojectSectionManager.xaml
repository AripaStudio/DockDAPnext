<UserControl x:Class="DockDAPnext.UserControls.projectManagersUCs.UCprojectSectionManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DockDAPnext.UserControls.projectManagersUCs"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#1E1E1E" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Project Configuration"
                   Foreground="#007ACC"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15" />

        <Border Grid.Row="1"
                Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock Text="Basic dub.json Fields" 
                               Foreground="#DCDCDC" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,15"
                               FontSize="13"/>

                    <StackPanel >

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name:" Grid.Column="0" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1"
                                     Background="#3F3F46"
                                     Foreground="#F1F1F1"
                                     CaretBrush="#F1F1F1"
                                     BorderBrush="#555555"
                                     Padding="5"
                                      />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Description:" Grid.Column="0" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1"
                                     Background="#3F3F46"
                                     Foreground="#F1F1F1"
                                     CaretBrush="#F1F1F1"
                                     BorderBrush="#555555"
                                     Padding="5"
                                      />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="License:" Grid.Column="0" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1"
                                     Background="#3F3F46"
                                     Foreground="#F1F1F1"
                                     CaretBrush="#F1F1F1"
                                     BorderBrush="#555555"
                                     Padding="5"
                                      />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Target Name:" Grid.Column="0" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1"
                                     Background="#3F3F46"
                                     Foreground="#F1F1F1"
                                     CaretBrush="#F1F1F1"
                                     BorderBrush="#555555"
                                     Padding="5"
                                      />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Target Type:" Grid.Column="0" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1"
                                      Background="#3F3F46"
                                      Foreground="#F1F1F1"
                                      BorderBrush="#555555"
                                      Padding="5"
                                      
                                      
                                      ToolTip="Select the type of executable to build (e.g., executable, library, none).">
                            </ComboBox>
                        </Grid>

                    </StackPanel>

                    <Separator Background="#3F3F46" Margin="0,20"/>

                </StackPanel>

            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
