<UserControl x:Class="DockDAPnext.UserControls.projectManagersUCs.UCprojectSectionManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DockDAPnext.UserControls.projectManagersUCs"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DockDAPnext;component/Themes/UIStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Project Configuration"
                   Foreground="{DynamicResource {x:Static vs:VsBrushes.AccentMediumKey}}"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15" />

        <Border Grid.Row="1"
                Background="{DynamicResource {x:Static vs:VsBrushes.CommandBarMenuBackgroundGradientKey}}"
                BorderBrush="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock Text="Basic dub.json Fields" 
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,15"
                               FontSize="13"/>

                    <StackPanel >

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name:" Grid.Column="0" Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1"
                                    
                                    
                                    
                                    
                                     Padding="5"
                                     Text="{Binding VmProjectDubManager.TxtNameProject , UpdateSourceTrigger=PropertyChanged}"
                                      />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Description:" Grid.Column="0" Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1"
                                    
                                    
                                    
                                    
                                     Padding="5"
                                     Text="{Binding VmProjectDubManager.TxtDescriptionProject , UpdateSourceTrigger=PropertyChanged}"
                                      />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="License:" Grid.Column="0" Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1"
                                    
                                    
                                    
                                    
                                     Padding="5"
                                     Text="{Binding VmProjectDubManager.TxtLicenseProject , UpdateSourceTrigger=PropertyChanged}"
                                      />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Target Name:" Grid.Column="0" Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1"
                                    
                                    
                                    
                                    
                                     Padding="5"
                                     Text="{Binding VmProjectDubManager.TxtTargetNameProject , UpdateSourceTrigger=PropertyChanged}"
                                      />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Target Type:" Grid.Column="0" Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Style="{DynamicResource {x:Static vs:VsResourceKeys.ThemedDialogComboBoxStyleKey}}" Grid.Column="1"
                                     
                                     
                                     
                                      Padding="5"
                                      ItemsSource="{Binding VmProjectDubManager.TargetTypeListComboBox}"
                                      SelectedItem="{Binding VmProjectDubManager.SelectedTargetType}"
                                      
                                      ToolTip="Select the type of executable to build (e.g., executable, library, none).">
                            </ComboBox>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Target Path:" Grid.Column="0" Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1"




                                     Padding="5"
                                     ToolTip="Folder for the build output, relative to the dub.json folder (e.g. Output). Empty means dub's own default."
                                     Text="{Binding VmProjectDubManager.TxtTargetPathProject , UpdateSourceTrigger=PropertyChanged}"
                                      />
                        </Grid>

                    </StackPanel>

                    <Separator Margin="0,20"/>

                </StackPanel>

            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
