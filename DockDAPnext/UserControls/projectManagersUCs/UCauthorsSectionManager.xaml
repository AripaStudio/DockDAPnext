<UserControl x:Class="DockDAPnext.UserControls.projectManagersUCs.UCauthorsSectionManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DockDAPnext.UserControls.projectManagersUCs"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DockDAPnext;component/Themes/UIStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Project Authors"
                   Foreground="{DynamicResource {x:Static vs:VsBrushes.AccentMediumKey}}"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15" />

        <Border Grid.Row="1"
                Background="{DynamicResource {x:Static vs:VsBrushes.CommandBarMenuBackgroundGradientKey}}"
                BorderBrush="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15">

            <StackPanel>

                <TextBlock Text="Add New Author" 
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,10"
                           FontSize="13"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                            
                            
                            
                            
                             Padding="5"
                             Margin="0,0,10,0"
                             ToolTip="Enter the name of the new author."
                             Text="{Binding VmProjectDubManager.TxtAddNewAuthors , UpdateSourceTrigger=PropertyChanged}"
                             />

                    <Button Style="{StaticResource PrimaryButton}" Grid.Column="1"
                            Width="120"
                            Command="{Binding VmProjectDubManager.ButtonCommandAuthorsAdd}"
                            >
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Add}" Width="16" Height="16" Margin="0,0,5,0"/>
                                <TextBlock Text="Add Author" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>

                <Separator Margin="0,15"/>

                <TextBlock Text="Current Authors" 
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,5"
                           FontSize="13"/>

                <ListBox 
                    Height="150"
                    ItemsSource="{Binding VmProjectDubManager.AuthorsList}"
                    SelectedItem="{Binding VmProjectDubManager.SelectedAuthor}"
                   
                   
                   
                    SelectionMode="Single"
                    Margin="0,0,0,10" />

                <Button Style="{StaticResource DangerButton}" 
                    Width="200"
                    
                    HorizontalAlignment="Center"
                    ToolTip="Removes the currently selected author from the list."
                    Command="{Binding VmProjectDubManager.ButtonCommandAuthorsRemove}"
                    >
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Remove}" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock Text="Remove Selected Author" />
                        </StackPanel>
                    </Button.Content>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
