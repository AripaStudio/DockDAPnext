<UserControl x:Class="DockDAPnext.UserControls.projectManagersUCs.UCbuildConfigurationsSectionManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DockDAPnext.UserControls.projectManagersUCs"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DockDAPnext;component/Themes/UIStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Advanced Build Configurations"
                   Foreground="{DynamicResource {x:Static vs:VsBrushes.AccentMediumKey}}"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15" />

        <Border Grid.Row="1"
                Background="{DynamicResource {x:Static vs:VsBrushes.CommandBarMenuBackgroundGradientKey}}"
                BorderBrush="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15">

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,-6">

                <TabControl BorderBrush="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}"
                            BorderThickness="1"
                           
                           
                            Padding="5">
                    <TabItem Header="Config Name">
                        <StackPanel Margin="10">
                            <TextBlock Text="Current Build Configuration Name (e.g., debug, release)" 
                   Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" Margin="0,0,0,5"/>
                            <Grid Margin="0,5,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                    
                    
                    
                    
                     Padding="5"
                     VerticalContentAlignment="Center"
                     Text="{Binding vmProjectDubManager.txtNameBuildConfig, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Style="{StaticResource PrimaryButton}" Grid.Column="1"
                    Margin="5,0,0,0"
                    Padding="10,0"
                    Command="{Binding vmProjectDubManager.ButtonCommand_ApplayNameBuildConfigurations}">
                                    <StackPanel Orientation="Horizontal">
                                        <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Edit}" Width="16" Height="16" Margin="0,0,5,0"/>
                                        <TextBlock Text="Apply Name" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="* This name identifies the configuration in DUB." 
                   Foreground="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}" FontSize="11" FontStyle="Italic"/>

                            <TextBlock Text="Add New Configuration Name" 
                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" Margin="0,15,0,5"/>
                            <Grid Margin="0,5,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                        
                                        
                                        
                                        
                                         Padding="5"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding vmProjectDubManager.txtAddNewConfigurationsName, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Style="{StaticResource SuccessButton}" Grid.Column="1"
                                        Margin="5,0,0,0"
                                        Padding="10,0"
                                        Command="{Binding vmProjectDubManager.ButtonCommand_AddNewNameBuildConfiguarations}">
                                    <StackPanel Orientation="Horizontal">
                                        <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Add}" Width="16" Height="16" Margin="0,0,5,0"/>
                                        <TextBlock Text="Add New" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock Text="Existing Configurations:" 
                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" Margin="0,10,0,5"/>
                            <ListBox Height="120"
                                    
                                    
                                    
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ItemsSource="{Binding vmProjectDubManager.NameConfigListCollection}" 
                                     SelectedItem="{Binding vmProjectDubManager.SelectedDeletedNameConfigOfList}">
                            </ListBox>

                            <Button Style="{StaticResource DangerButton}" Margin="0,5,0,0"
                                    HorizontalAlignment="Right"
                                    Padding="10,2"
                                    Command="{Binding vmProjectDubManager.ButtonCommand_DeleteNameConfigurations}">
                                <StackPanel Orientation="Horizontal">
                                    <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.DeleteStep}" Width="14" Height="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Remove Selected" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Build Options">
                        <StackPanel Margin="10">
                            <TextBlock Text="Select Build Option to Add" Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" Margin="0,0,0,5"/>
                            <ComboBox Style="{DynamicResource {x:Static vs:VsResourceKeys.ThemedDialogComboBoxStyleKey}}" Margin="0,5,0,10"
                             
                             
                             
                              Padding="5"
                              ItemsSource="{Binding vmProjectDubManager.BuildPOptionTypesComboBox}"
                              SelectedItem="{Binding vmProjectDubManager.SelectedBuildOptionComboBox }"
                              >
                            </ComboBox>

                            <Button Style="{StaticResource PrimaryButton}" Margin="0,0,0,5"
                                Width="160"
                                HorizontalAlignment="Center"
                                Command="{Binding vmProjectDubManager.ButtonCommand_AddBuildOption}"
                                >
                                <StackPanel Orientation="Horizontal">
                                    <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Add}" Width="16" Height="16" Margin="0,0,5,0"/>
                                    <TextBlock Text="Add Option" />
                                </StackPanel>
                            </Button>

                            <ListBox Height="100"
                                
                                
                                
                                 Margin="0,5,0,5" 
                                 ItemsSource="{Binding vmProjectDubManager.BuildOptionsList}"
                                 SelectedItem="{Binding vmProjectDubManager.SelectedBuildOption }"
                                 />

                            <Button Style="{StaticResource DangerButton}" Margin="0,5,0,0"
                                Width="160"
                                HorizontalAlignment="Center"
                                Command="{Binding vmProjectDubManager.ButtonCommand_RemoveBuildOption}">
                                <StackPanel Orientation="Horizontal">
                                    <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Remove}" Width="16" Height="16" Margin="0,0,5,0"/>
                                    <TextBlock Text="Remove Option" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="D Flags">
                        <StackPanel Margin="10">
                            <TextBlock Text="Add D Compiler Flag (e.g., -unittest)" Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" Margin="0,0,0,5"/>
                            <TextBox Margin="0,5,0,10"
                                    
                                    
                                    
                                    
                                     Padding="5"
                                     Text="{Binding vmProjectDubManager.txtAddDFlag, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Style="{StaticResource PrimaryButton}" Margin="0,0,0,5"
                                    Width="150"
                                    HorizontalAlignment="Center"
                                    Command="{Binding vmProjectDubManager.ButtonCommand_DFlag_Add}">
                                <StackPanel Orientation="Horizontal">
                                    <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Add}" Width="16" Height="16" Margin="0,0,5,0"/>
                                    <TextBlock Text="Add D Flag" />
                                </StackPanel>
                            </Button>

                            <ListBox Height="100"
                                    
                                    
                                    
                                     Margin="0,0,0,5"
                                     ItemsSource="{Binding vmProjectDubManager.DFlagsList}" 
                                     SelectedItem="{Binding vmProjectDubManager.SelectedDFlag}" />

                            <Button Style="{StaticResource DangerButton}" Margin="0,5,0,0"
                                    Width="150"
                                    HorizontalAlignment="Center"
                                    Command="{Binding vmProjectDubManager.ButtonCommand_DFlag_Remove}">
                                <StackPanel Orientation="Horizontal">
                                    <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Remove}" Width="16" Height="16" Margin="0,0,5,0"/>
                                    <TextBlock Text="Remove D Flag" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="L Flags">
                        <StackPanel Margin="10">
                            <TextBlock Text="Add Linker Flag (e.g., -L/usr/lib)" Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" Margin="0,0,0,5"/>
                            <TextBox Margin="0,5,0,10"
                                    
                                    
                                    
                                    
                                     Padding="5"
                                     Text="{Binding vmProjectDubManager.txtAddLFlag, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Style="{StaticResource PrimaryButton}" Margin="0,0,0,5"
                                    Width="150"
                                    HorizontalAlignment="Center"
                                    Command="{Binding vmProjectDubManager.ButtonCommand_LFlag_Add}">
                                <StackPanel Orientation="Horizontal">
                                    <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Add}" Width="16" Height="16" Margin="0,0,5,0"/>
                                    <TextBlock Text="Add L Flag" />
                                </StackPanel>
                            </Button>

                            <ListBox Height="100"
                                    
                                    
                                    
                                     Margin="0,0,0,5"
                                     ItemsSource="{Binding vmProjectDubManager.LFlagsList}" 
                                     SelectedItem="{Binding vmProjectDubManager.SelectedLFlag}" />

                            <Button Style="{StaticResource DangerButton}" Margin="0,5,0,0"
                                    Width="150"
                                    HorizontalAlignment="Center"
                                    Command="{Binding vmProjectDubManager.ButtonCommand_LFlag_Remove}">
                                <StackPanel Orientation="Horizontal">
                                    <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Remove}" Width="16" Height="16" Margin="0,0,5,0"/>
                                    <TextBlock Text="Remove L Flag" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Versions">
                        <StackPanel Margin="10">
                            <TextBlock Text="Add Version Identifier (e.g., Have_MyFeature)" Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" Margin="0,0,0,5"/>
                            <TextBox Margin="0,5,0,10"
                                    
                                    
                                    
                                    
                                     Padding="5"
                                     Text="{Binding vmProjectDubManager.txtAddVersion, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Style="{StaticResource PrimaryButton}" Margin="0,0,0,5"
                                    Width="150"
                                    HorizontalAlignment="Center"
                                    Command="{Binding vmProjectDubManager.ButtonCommand_Version_Add}">
                                <StackPanel Orientation="Horizontal">
                                    <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Add}" Width="16" Height="16" Margin="0,0,5,0"/>
                                    <TextBlock Text="Add Version" />
                                </StackPanel>
                            </Button>

                            <ListBox Height="100"
                                    
                                    
                                    
                                     Margin="0,0,0,5"
                                     ItemsSource="{Binding vmProjectDubManager.VersionsList}" 
                                     SelectedItem="{Binding vmProjectDubManager.SelectedVersion}" />

                            <Button Style="{StaticResource DangerButton}" Margin="0,5,0,0"
                                    Width="150"
                                    HorizontalAlignment="Center"
                                    Command="{Binding vmProjectDubManager.ButtonCommand_Version_Remove}">
                                <StackPanel Orientation="Horizontal">
                                    <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Remove}" Width="16" Height="16" Margin="0,0,5,0"/>
                                    <TextBlock Text="Remove Version" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Other Configs">
                        <StackPanel Margin="10">

                            <TextBlock Text="Define Custom Configuration" 
                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" 
                                       FontWeight="SemiBold" 
                                       Margin="0,0,0,10"
                                       FontSize="13"/>

                            <Grid Margin="0,5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" VerticalAlignment="Center" Margin="0,0,5,5"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         ToolTip="Enter configuration name (e.g., debug-windows)"
                                        
                                        
                                        
                                        
                                         Padding="5"
                                         Margin="0,0,0,5"
                                         Text="{Binding vmProjectDubManager.txtOtherConfigName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Value:" Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" VerticalAlignment="Center" Margin="0,5,5,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         ToolTip="Enter a description or custom property value."
                                        
                                        
                                        
                                        
                                         Padding="5"
                                         Margin="0,5,0,0"
                                         Text="{Binding vmProjectDubManager.txtOtherConfigValue, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Button Style="{StaticResource PrimaryButton}" Margin="0,10,0,15"
                                    Width="180"
                                    HorizontalAlignment="Center"
                                    Command="{Binding vmProjectDubManager.ButtonCommand_OtherConfig_Add}">
                                <StackPanel Orientation="Horizontal">
                                    <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Add}" Width="16" Height="16" Margin="0,0,5,0"/>
                                    <TextBlock Text="Add Config" />
                                </StackPanel>
                            </Button>

                            <ListBox Height="100"
                                    
                                    
                                    
                                     SelectionMode="Single"
                                     Margin="0,0,0,10"
                                     ItemsSource="{Binding vmProjectDubManager.OtherConfigsList}" 
                                     SelectedItem="{Binding vmProjectDubManager.SelectedOtherConfig}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontWeight="Bold" Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" Margin="0,0,5,0" Text="{Binding Item1}"/>
                                            <TextBlock Grid.Column="1" Text=": " Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" Margin="0,0,5,0"/>
                                            <TextBlock Grid.Column="2" Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" TextWrapping="Wrap" Text="{Binding Item2}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button Style="{StaticResource DangerButton}" 
                                Width="200"
                                HorizontalAlignment="Center"
                                Command="{Binding vmProjectDubManager.ButtonCommand_OtherConfig_Remove}">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Remove}" Width="16" Height="16" Margin="0,0,5,0"/>
                                        <TextBlock Text="Remove Config" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                    </TabItem>

                </TabControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
