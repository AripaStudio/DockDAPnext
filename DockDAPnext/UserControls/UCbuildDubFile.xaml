<UserControl x:Class="DockDAPnext.UserControls.UCbuildDubFile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DockDAPnext.UserControls"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             mc:Ignorable="d" 
            >
    <Grid Background="#1E1E1E" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Dub Build &amp; Run Manager"
                   Foreground="#007ACC"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15" />

        <Border Grid.Row="1"
                Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15">

            <StackPanel>

                <TextBlock Text="Quick Build Configurations" 
                           Foreground="#DCDCDC" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,10"
                           FontSize="13"/>

                <Grid Margin="0,5,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Foreground="#DCDCDC"
                                   Text="Build for Debugging (dub build --build=debug)"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock Foreground="#A0A0A0"
                                   Text="Use for development and testing with full symbol information."
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Background="#5337B6"
                            Foreground="White"
                            FontWeight="Bold"
                            Height="30"
                            Width="100"
                            Command="{Binding vmBuildDubFile.ButtonCommand_buildDebug}"
                            >
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Bug}" Width="16" Height="16" Margin="0,0,5,0"/>
                                <TextBlock Text="Debug" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>

                <Separator Background="#3F3F46" Margin="0,15"/>

                <Grid Margin="0,5,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Foreground="#DCDCDC"
                                   Text="Build for Release (dub build --build=release)"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock Foreground="#A0A0A0"
                                   Text="Optimized for performance and final distribution."
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Background="#D0313C"
                            Foreground="White"
                            FontWeight="Bold"
                            Height="30"
                            Width="100"
                            Command="{Binding vmBuildDubFile.ButtonCommand_buildRelease}"
                            >
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.StartTestGroupWithDebugger}" Width="16" Height="16" Margin="0,0,5,0"/>
                                <TextBlock Text="Release" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>

                <Separator Background="#3F3F46" Margin="0,15"/>

                <Grid Margin="0,5,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Foreground="#DCDCDC"
                                   Text="Default Build (dub build)"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock Foreground="#A0A0A0"
                                   Text="Runs the default configuration specified in dub.json."
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Background="#007ACC"
                            Foreground="White"
                            FontWeight="Bold"
                            Height="30"
                            Width="100"
                            Command="{Binding vmBuildDubFile.ButtonCommand_buildDefault}"
                            >
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.StartTestWithoutDebugger}" Width="16" Height="16" Margin="0,0,5,0"/>
                                <TextBlock Text="Default" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>

                <Separator Background="#3F3F46" Margin="0,15"/>

                <TextBlock Foreground="#A0A0A0"
                           Margin="5,10,5,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="All dub commands will be executed in the project directory and their output displayed in the 'Dub Manager' Output Window pane." />

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
