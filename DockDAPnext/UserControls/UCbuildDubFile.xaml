<UserControl x:Class="DockDAPnext.UserControls.UCbuildDubFile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DockDAPnext.UserControls"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DockDAPnext;component/Themes/UIStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}"
                   Text="Dub Build &amp; Run Manager" />

        <Border Grid.Row="1"
                Background="{DynamicResource {x:Static vs:VsBrushes.CommandBarMenuBackgroundGradientKey}}"
                BorderBrush="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15">

            <StackPanel>

                <TextBlock Style="{StaticResource SubTitle}" Text="Quick Build Configurations" />

                <CheckBox IsChecked="{Binding VmBuildDubFile.RunAfterBuild}"
                          Margin="0,0,0,8"
                          Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"
                          Content="Run the program automatically after a successful build (executable targets only)" />

                <Border Background="{DynamicResource {x:Static vs:VsBrushes.CommandBarMenuBackgroundGradientKey}}"
                        BorderBrush="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,0,0,8">
                    <TextBlock Text="{Binding VmBuildDubFile.BuildStatusText}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" />
                </Border>

                <Grid Margin="0,5,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"
                                   Text="Build for Debugging (dub build --build=debug)"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Use for development and testing with full symbol information."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Style="{StaticResource BuildButton}" Grid.Column="1"
                            Height="30"
                            Width="100"
                            Command="{Binding VmBuildDubFile.ButtonCommandBuildDebug}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Bug}" Width="16" Height="16" Margin="0,0,5,0"/>
                                <TextBlock Text="Debug" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>

                <Separator Margin="0,15"/>

                <Grid Margin="0,5,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"
                                   Text="Build for Release (dub build --build=release)"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Optimized for performance and final distribution."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Style="{StaticResource DangerButton}" Grid.Column="1"
                            Height="30"
                            Width="100"
                            Command="{Binding VmBuildDubFile.ButtonCommandBuildRelease}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.StartTestGroupWithDebugger}" Width="16" Height="16" Margin="0,0,5,0"/>
                                <TextBlock Text="Release" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>

                <Separator Margin="0,15"/>

                <Grid Margin="0,5,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"
                                   Text="Default Build (dub build)"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Runs the default configuration specified in dub.json."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" Grid.Column="1"
                            Height="30"
                            Width="100"
                            Command="{Binding VmBuildDubFile.ButtonCommandBuildDefault}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.StartTestWithoutDebugger}" Width="16" Height="16" Margin="0,0,5,0"/>
                                <TextBlock Text="Default" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>

                <Separator Margin="0,15"/>

                <TextBlock Style="{StaticResource HintText}"
                           Margin="5,10,5,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="All dub commands will be executed in the project directory and their output displayed in the 'Dub Manager' Output Window pane." />

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
