<UserControl x:Class="DockDAPnext.UserControls.UCabouteMe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DockDAPnext.UserControls"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="700">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DockDAPnext;component/Themes/UIStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}">
            <Run Text="DockDAPnext" /> <Run Text="|" Foreground="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}" /> <Run Text="Aripa Pars Studio" />
        </TextBlock>

        <Border Grid.Row="1"
                Background="{DynamicResource {x:Static vs:VsBrushes.CommandBarMenuBackgroundGradientKey}}"
                BorderBrush="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="22">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Right column: intro + actions -->
                <StackPanel Grid.Column="0">

                    <TextBlock Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,12">
                        <Run Text="Hello, I am " /><Run Text="Khashayar Mobasheri," FontWeight="Bold" />
                        <Run Text=" founder of " /><Run Text="Aripa Pars Studio." FontWeight="Bold" Foreground="{DynamicResource {x:Static vs:VsBrushes.AccentMediumKey}}" />
                    </TextBlock>

                    <TextBlock Foreground="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}"
                               TextWrapping="Wrap"
                               TextAlignment="Justify"
                               LineHeight="22"
                               Margin="0,0,0,18">
                        This extension is designed to improve the workflow for Dub and D language developers. It's a simple, yet powerful and useful extension. If you like the vision of Aripa Studio, I'd appreciate your support and feedback! 💖
                    </TextBlock>

                    <Separator Margin="0,6,0,18" />

                    <TextBlock Style="{StaticResource SubTitle}" Text="Connect &amp; Support" />

                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"
                                ToolTip="Visit Aripa Pars Website"
                                Command="{Binding vmAboutMe.ButtonCommand_WebSiteLink}">
                            <StackPanel Orientation="Horizontal">
                                <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Web}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Website" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"
                                ToolTip="Check out the Source Code"
                                Command="{Binding vmAboutMe.ButtonCommand_GithubLink}">
                            <StackPanel Orientation="Horizontal">
                                <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.GitHub}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="GitHub" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PrimaryButton}"
                                ToolTip="Share Your Thoughts"
                                Command="{Binding vmAboutMe.ButtonCommand_TelegramLink}">
                            <StackPanel Orientation="Horizontal">
                                <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Link}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Telegram" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <!-- Left column: card with vertical accent line -->
                <StackPanel Grid.Column="2" Margin="20,4,0,0">
                    <Border Width="1" Height="120" Background="{DynamicResource {x:Static vs:VsBrushes.PanelSeparatorKey}}" HorizontalAlignment="Right" Margin="0,0,16,14" />
                    <TextBlock Text="D &amp; Dub"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.AccentMediumKey}}"
                               FontSize="22" FontWeight="ExtraBold"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="Package Manager Tooling"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               Margin="0,2,0,0" />
                    <TextBlock Text="v2.0.0"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
