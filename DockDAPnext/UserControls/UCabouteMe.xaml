<UserControl x:Class="DockDAPnext.UserControls.UCabouteMe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DockDAPnext.UserControls"
             xmlns:toolkit="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             mc:Ignorable="d" 
             >

    <Grid Background="#1E1E1E" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="DockDAPnext | Aripa Pars Studio"
                       Foreground="#007ACC"
                       FontSize="20"
                       FontWeight="ExtraBold" />
            <TextBlock Text="D Language &amp; Dub Management Extension"
                       Foreground="#DCDCDC"
                       FontSize="12" />
        </StackPanel>

        <Border Grid.Row="1" 
                Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                CornerRadius="4"
                Padding="20">
            <StackPanel>

                <TextBlock Margin="0,0,0,10" Foreground="#DCDCDC" TextAlignment="Center">
                    <Run Text="Hello, I am Khashayar Mobasheri," FontWeight="Bold" FontSize="15" />
                    <Run Text=" founder of " />
                    <Run Text="Aripa Pars Studio." FontWeight="Bold" Foreground="#007ACC" />
                </TextBlock>

                <TextBlock Margin="0,0,0,25" 
                           Foreground="#DCDCDC"
                           TextWrapping="Wrap"
                           TextAlignment="Justify"
                           Opacity="0.8">
                    This extension is designed to improve the workflow for Dub and D language developers. It's a simple, yet powerful and useful extension. If you like the vision of Aripa Studio, I'd appreciate your support and feedback! 💖
                </TextBlock>

                <Separator Background="#3F3F46" Margin="0,10,0,20"/>

                <TextBlock Text="Connect &amp; Support" 
                           Foreground="#DCDCDC" 
                           FontWeight="Bold" 
                           Margin="0,0,0,10"
                           HorizontalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <Button Background="#007ACC"
                            Margin="5" 
                            ToolTip="Visit Aripa Pars Website"
                            Command="{Binding vmAboutMe.ButtonCommand_WebSiteLink}"
                    >
                        <StackPanel Orientation="Horizontal">
                            <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Web}" Margin="0,0,5,0" Width="16" Height="16"/>
                            <TextBlock Text="Website" />
                        </StackPanel>
                    </Button>

                    <Button Background="#007ACC"
                            Margin="5"
                            ToolTip="Check out the Source Code"
                            Command="{Binding vmAboutMe.ButtonCommand_GithubLink}"
                    >
                        <StackPanel Orientation="Horizontal">
                            <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.GitHub}" Margin="0,0,5,0" Width="16" Height="16"/>
                            <TextBlock Text="GitHub" />
                        </StackPanel>
                    </Button>

                    <Button Background="#007ACC"
                            Margin="5"
                            ToolTip="Share Your Thoughts"
                            Command="{Binding vmAboutMe.ButtonCommand_TelegramLink}"
                    >
                        <StackPanel Orientation="Horizontal">
                            <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Link}" Margin="0,0,5,0" Width="16" Height="16"/>
                            <TextBlock Text="Telegram" />
                        </StackPanel>
                    </Button>

                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>
