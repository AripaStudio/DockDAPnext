<UserControl x:Class="DockDAPnext.UserControls.UCshowDubFile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DockDAPnext.UserControls"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             mc:Ignorable="d" 
             >
    <Grid Background="#1E1E1E" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Dub Configuration File"
                   Foreground="#007ACC"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15" />

        <Border Grid.Row="1"
                Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                CornerRadius="4"
                Padding="20">

            <StackPanel HorizontalAlignment="Center">

                <TextBlock Foreground="#DCDCDC"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontSize="13"
                           Margin="0,0,0,15">
                    Quickly locate and open the primary configuration file (<Run FontWeight="Bold">dub.json</Run>) for editing within the Visual Studio environment.
                </TextBlock>

                <Button 
                    Width="180"
                    Height="35"
                    Background="#007ACC"
                    Foreground="White"
                    FontWeight="Bold"
                    Margin="5,10"
                    Command="{Binding vmShowDubFile.ButtonCommand_OpenDub}"
                    >

                    <Button.Content>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.OpenFile}" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock Text="Open dub.json" />
                        </StackPanel>
                    </Button.Content>
                </Button>

                <Separator Background="#3F3F46" Margin="0,15"/>

                <TextBlock Foreground="#A0A0A0"
                           Margin="5"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontSize="11"
                           Text="Tip: If the file does not exist, you can create it in the Project tab." />

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
