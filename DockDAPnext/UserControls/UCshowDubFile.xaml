<UserControl x:Class="DockDAPnext.UserControls.UCshowDubFile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DockDAPnext.UserControls"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DockDAPnext;component/Themes/UIStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}"
                   Text="Dub Configuration File" />

        <Border Grid.Row="1"
                Background="{DynamicResource {x:Static vs:VsBrushes.CommandBarMenuBackgroundGradientKey}}"
                BorderBrush="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="20">

            <StackPanel HorizontalAlignment="Center">

                <TextBlock Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontSize="13"
                           Margin="0,0,0,15">
                    Quickly locate and open the primary configuration file (<Run FontWeight="Bold">dub.json</Run>) for editing within the Visual Studio environment.
                </TextBlock>

                <Button Style="{StaticResource PrimaryButton}"
                    Width="180"
                    Height="35"
                    Margin="5,10"
                    Command="{Binding VmShowDubFile.ButtonCommandOpenDub}">

                    <Button.Content>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.OpenFile}" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock Text="Open dub.json" />
                        </StackPanel>
                    </Button.Content>
                </Button>

                <Separator Margin="0,15"/>

                <TextBlock Style="{StaticResource HintText}"
                           Margin="5"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="Tip: If the file does not exist, you can create it in the Project tab." />

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
