<UserControl x:Class="DockDAPnext.UserControls.UCaiAssistant"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DockDAPnext.UserControls"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DockDAPnext;component/Themes/UIStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="AI Assistant"
                   Foreground="{DynamicResource {x:Static vs:VsBrushes.AccentMediumKey}}"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15" />

        <Border Grid.Row="1"
                Background="{DynamicResource {x:Static vs:VsBrushes.CommandBarMenuBackgroundGradientKey}}"
                BorderBrush="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15">

            <StackPanel>

                <TextBlock Style="{StaticResource SubTitle}" Text="Ask an LLM (OpenAI-compatible endpoint)" />

                <TextBlock Style="{StaticResource HintText}"
                           Margin="0,5,0,10"
                           TextWrapping="Wrap"
                           Text="Configuration lives in %APPDATA%\DockDAPnext\ai.json (endpoint, apiKey, model). Local servers like Ollama or LM Studio work too and need no apiKey." />

                <TextBlock Text="Prompt"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5" />

                <TextBox AcceptsReturn="True"
                         AcceptsTab="True"
                         Height="90"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding vmAiAssistant.AiPromptText, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource PrimaryButton}"
                            Width="110"
                            Content="Send"
                            Command="{Binding vmAiAssistant.ButtonCommand_AiSend}" />
                    <Button Style="{StaticResource BuildButton}"
                            Width="130"
                            Margin="10,0,0,0"
                            Content="Create AI config"
                            Command="{Binding vmAiAssistant.ButtonCommand_AiCreateConfig}" />
                    <Button Style="{StaticResource PrimaryButton}"
                            Width="110"
                            Margin="10,0,0,0"
                            Content="Open config"
                            Command="{Binding vmAiAssistant.ButtonCommand_AiOpenConfig}" />
                </StackPanel>

                <Separator Margin="0,15" />

                <TextBlock Text="Answer"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5" />

                <TextBox IsReadOnly="True"
                         AcceptsReturn="True"
                         Height="170"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FlowDirection="LeftToRight"
                         Text="{Binding vmAiAssistant.AiResponseText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"
                           Text="{Binding vmAiAssistant.AiStatusText}" />

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
